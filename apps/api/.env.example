# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agendo?schema=public

# --- Auth ---
# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
